{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "// Provider": "Sqlite (default, no server needed) or MySql",
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=alzawatchdog.db"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Admin": {
    "// Keys": "Account keys with admin access. Paste the GUID from a user's URL.",
    "Keys": []
  },
  "Watchdog": {
    "Enabled": true,
    "CheckInterval": "06:00:00",
    "DelayBetweenRequests": "00:00:05",
    "RequestJitter": "00:00:03",
    "BlockedBackoff": "00:30:00",
    "MaxConsecutiveFailures": 10
  }
}
