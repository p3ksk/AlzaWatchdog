{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "// Provider": "Sqlite (default, no server needed) or MySql",
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=alzawatchdog.db"
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200"
    ]
  },
  "Admin": {
    "// Keys": "Account keys with admin access. Paste the GUID from a user's URL.",
    "Keys": []
  },
  "Cleanup": {
    "Enabled": true,
    "DryRun": false,
    "Interval": "12:00:00",
    "// EmptyAccountAge": "Accounts with no products, untouched this long, are deleted.",
    "EmptyAccountAge": "2.00:00:00",
    "// InactiveAccountAge": "Accounts with products, untouched this long, are deleted.",
    "InactiveAccountAge": "182.00:00:00"
  },
  "Watchdog": {
    "Enabled": true,
    "CheckInterval": "06:00:00",
    "DelayBetweenRequests": "00:00:05",
    "RequestJitter": "00:00:03",
    "SweepWindow": "00:05:00",
    "BlockedBackoff": "00:30:00",
    "ChallengeRetryDelay": "00:00:15",
    "InteractiveChallengeRetryDelay": "00:00:03",
    "MaxConsecutiveFailures": 10,
    "LogRequests": false
  }
}
